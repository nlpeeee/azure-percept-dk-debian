"""Launcher so `python percept <command>` (or ./percept) works from a checkout."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "src"))

from percept.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
